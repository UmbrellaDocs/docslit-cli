{
  "name": "docslit",
  "version": "0.2.1",
  "description": "The best open-source docs platform, built for AI agents. Markdown + Lit web components",
  "homepage": "https://docslit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UmbrellaDocs/docslit-cli.git"
  },
  "author": "Gaurav Nelson",
  "type": "module",
  "bin": {
    "docslit": "bin/docslit.js"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "skills",
    "LICENSE",
    "NOTICES",
    "!src/**/*.test.js",
    "!src/**/*.test.ts",
    "!src/test-fixtures"
  ],
  "scripts": {
    "test": "vitest run",
    "preview": "node scripts/preview.js",
    "vendor": "node scripts/download-vendor.js",
    "prepack": "node scripts/download-vendor.js",
    "skills": "node scripts/build-skills.js",
    "icons": "node scripts/build-icons.js",
    "benchmark": "node scripts/benchmark-build.js"
  },
  "keywords": [
    "docs",
    "documentation",
    "lit",
    "web-components",
    "markdown",
    "static-site",
    "ai",
    "open-source",
    "cli",
    "ai-agents",
    "ai-docs",
    "agent-docs"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@redocly/openapi-core": "2.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "chokidar": "^6.0.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "flexsearch": "^0.8.212",
    "fs-extra": "^11.4.1",
    "image-size": "^2.1.0",
    "isomorphic-git": "^1.44.17",
    "js-yaml": "^5.5.0",
    "katex": "^0.19.1",
    "openapi-overlays-js": "^0.2.0",
    "pdf-lib": "^1.17.1",
    "picocolors": "^1.1.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.2",
    "lit": "^3.3.3",
    "lucide-static": "1.75.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "peerDependencies": {
    "playwright": ">=1.65.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "katex": "$katex",
    "minimatch": "11.0.1",
    "underscore": "^1.13.8"
  }
}
